 if not use_bundled_wx
     wx_dep = dependency('wxWidgets', version: '>=' + get_option('wx_version'),
@@ -331,10 +337,12 @@ else
 
     conf.set('WITH_INTERNAL_WXWIDGETS', 1)
 endif
+endif # not core_only
 
