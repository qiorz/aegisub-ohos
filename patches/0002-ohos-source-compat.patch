+	// OHOS libc++ 15 is built with _LIBCPP_HAS_NO_INCOMPLETE_RANGES, so
+	// std::views is unavailable. Accumulate manually instead.
+	int64_t acc = 0;
+	if (endian::IsBigEndian) {
+		for (uint8_t value : data)
